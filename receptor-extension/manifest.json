{
  "manifest_version": 3,
  "name": "Facturito",
  "version": "1.0.1",
  "description": "Guarda información de facturación localmente y llena los formularios de factura.gob.sv con un click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://factura.gob.sv/*",
    "https://*.factura.gob.sv/*",
    "https://*.mh.gob.sv/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Facturito",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://factura.gob.sv/*",
        "https://*.factura.gob.sv/*",
        "https://*.mh.gob.sv/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
